; InfinaBox "Blank 2D" template. When a project is created, InfinaBox sets
; config/name and adds the InfinaBox addon (addons/infinabox/) with its
; [autoload] and [editor_plugins] entries. Godot may rewrite this file (and
; drop these comments) when the project is saved from the editor.

config_version=5

[application]

config/name="Blank 2D"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
