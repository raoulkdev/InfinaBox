; InfinaBox "Arena shooter" template. When a project is created, InfinaBox
; sets config/name and adds the InfinaBox addon (addons/infinabox/) with its
; [autoload] and [editor_plugins] entries. The [input] actions below were
; written by Godot itself. Godot may rewrite this file (and drop these
; comments) when the project is saved from the editor.

config_version=5

[application]

config/name="Arena Shooter"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

