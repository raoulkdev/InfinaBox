[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/main.gd" id="1_main"]
[ext_resource type="PackedScene" path="res://scenes/level.tscn" id="2_level"]
[ext_resource type="PackedScene" path="res://scenes/player.tscn" id="3_player"]
[ext_resource type="PackedScene" path="res://scenes/hud.tscn" id="4_hud"]

[sub_resource type="Environment" id="Environment_1"]
background_mode = 1
background_color = Color(0.02, 0.02, 0.03, 1)
ambient_light_source = 2
ambient_light_color = Color(0.42, 0.46, 0.6, 1)
ambient_light_energy = 0.55
tonemap_mode = 2
fog_enabled = true
fog_light_color = Color(0.04, 0.04, 0.07, 1)
fog_density = 0.012

; Main keeps running while the game is paused (process_mode 3 = Always) so
; it can show the start screen and handle Esc; the World is what freezes
; (process_mode 1 = Pausable).
[node name="Main" type="Node3D"]
process_mode = 3
script = ExtResource("1_main")

[node name="World" type="Node3D" parent="."]
process_mode = 1

[node name="WorldEnvironment" type="WorldEnvironment" parent="World"]
environment = SubResource("Environment_1")

[node name="Level" parent="World" instance=ExtResource("2_level")]

; The player starts in the first room, facing the first door (east).
[node name="Player" parent="World" instance=ExtResource("3_player")]
transform = Transform3D(0, 0, 1, 0, 1, 0, -1, 0, 0, 4.5, 0.02, 6)

[node name="HUD" parent="." instance=ExtResource("4_hud")]
