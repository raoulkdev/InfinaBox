[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/hud.gd" id="1_hud"]
[ext_resource type="Script" path="res://scripts/crosshair.gd" id="2_crosshair"]
[ext_resource type="PackedScene" path="res://scenes/start_screen.tscn" id="3_start"]
[ext_resource type="PackedScene" path="res://scenes/end_screen.tscn" id="4_end"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
content_margin_left = 16.0
content_margin_top = 12.0
content_margin_right = 16.0
content_margin_bottom = 12.0
bg_color = Color(0.03, 0.03, 0.05, 0.6)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12

; Everything drawn on top of the 3D world.
[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="Crosshair" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("2_crosshair")

[node name="Prompt" type="Label" parent="."]
anchors_preset = 10
anchor_left = 0.0
anchor_top = 0.58
anchor_right = 1.0
anchor_bottom = 0.58
offset_bottom = 36.0
grow_horizontal = 2
mouse_filter = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.9)
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 26
horizontal_alignment = 1

[node name="Message" type="Label" parent="."]
anchors_preset = 10
anchor_left = 0.0
anchor_top = 0.4
anchor_right = 1.0
anchor_bottom = 0.4
offset_bottom = 40.0
grow_horizontal = 2
mouse_filter = 2
theme_override_colors/font_color = Color(1, 0.84, 0.35, 1)
theme_override_colors/font_outline_color = Color(0.1, 0.06, 0.02, 1)
theme_override_constants/outline_size = 8
theme_override_font_sizes/font_size = 32
horizontal_alignment = 1

[node name="Counters" type="PanelContainer" parent="."]
offset_left = 20.0
offset_top = 20.0
offset_right = 240.0
offset_bottom = 90.0
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="Rows" type="VBoxContainer" parent="Counters"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="KeysRow" type="HBoxContainer" parent="Counters/Rows"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 12

[node name="KeysLabel" type="Label" parent="Counters/Rows/KeysRow"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.93, 0.88, 1)
theme_override_font_sizes/font_size = 20
text = "Keys"

[node name="KeyRow" type="HBoxContainer" parent="Counters/Rows/KeysRow"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="DoorsLabel" type="Label" parent="Counters/Rows"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.85, 0.9, 1)
theme_override_font_sizes/font_size = 18
text = "Doors opened  0 / 3"

[node name="StartScreen" parent="." instance=ExtResource("3_start")]
unique_name_in_owner = true

[node name="EndScreen" parent="." instance=ExtResource("4_end")]
unique_name_in_owner = true
