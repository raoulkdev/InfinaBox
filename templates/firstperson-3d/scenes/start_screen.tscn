[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/start_screen.gd" id="1_start"]

; Shown before the game starts and when it is paused. It works while the
; game is paused (process_mode 3 = Always).
[node name="StartScreen" type="Control"]
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_start")

[node name="Dim" type="ColorRect" parent="."]
