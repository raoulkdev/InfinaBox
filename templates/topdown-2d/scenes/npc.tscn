speaker_name = "Moss"
lines = Array[String](["Oh! A visitor! Hi, I'm Moss.", "The way out is through the big door in the hall. Sadly, it's locked.", "I dropped the key somewhere in the hall... right next to a very grumpy slime.", "If the slime bumps into you, you lose a heart. Lose all three and you start over!", "Good luck! Come back and tell me all about it."])

