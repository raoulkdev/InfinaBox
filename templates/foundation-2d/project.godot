; InfinaBox "Foundation (2D)" foundation. When a project is created, InfinaBox sets
; config/name and adds the InfinaBox addon (addons/infinabox/) with its
; [autoload] and [editor_plugins] entries. Godot may rewrite this file (and
; drop these comments) when the project is saved from the editor.

config_version=5

[application]

config/name="Foundation"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Events="*res://core/events.gd"
UserSettings="*res://core/user_settings.gd"
SceneRouter="*res://core/scene_router.gd"
GameState="*res://core/game_state.gd"
SaveSystem="*res://core/save_system.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventJoypadButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"button_index":6,"pressure":0.0,"pressed":false,"script":null)
]
}

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemies"
2d_physics/layer_4="interactables"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
